"""
LiveKit Voice Agent Boilerplate

A minimal voice AI agent using OpenAI Realtime API.
The Realtime API includes built-in STT, LLM, TTS, and turn detection.
Runnable in console mode for testing.
"""

from dotenv import load_dotenv

from livekit import agents, rtc
from livekit.agents import AgentServer, AgentSession, Agent, room_io
from livekit.plugins import noise_cancellation, openai

from tools import get_current_time
from prompts import AGENT_INSTRUCTIONS

# Load environment variables from root-level .env file
load_dotenv()


class Assistant(Agent):
    """
    Basic assistant agent with simple instructions.
    """
    def __init__(self) -> None:
        super().__init__(
            instructions=AGENT_INSTRUCTIONS,
            tools=[get_current_time],
        )


server = AgentServer()


@server.rtc_session(agent_name="assistant")
async def my_agent(ctx: agents.JobContext):
    """
    Main agent session handler.
    Uses OpenAI Realtime API which includes STT, LLM, TTS, and turn detection.
    """
    print(f"AGENT DISPATCHED: Room={ctx.room.name}")
    
    session = AgentSession(
        # OpenAI Realtime API includes built-in turn detection, STT, LLM, and TTS
        llm=openai.realtime.RealtimeModel(
            voice="shimmer"  # Options: alloy, echo, fable, onyx, nova, shimmer
        ),
        # Turn detection is built into OpenAI Realtime API
        turn_detection=None,
    )

    ##############PRINT STT TEXT (User Transcripts) ##########################
    def on_user_message(event):
        """Handle user messages/transcripts from Realtime API"""
        # The event contains the transcribed text
        if hasattr(event, 'content') and event.content:
            print("🎤 STT:", event.content)
        elif hasattr(event, 'text') and event.text:
            print("🎤 STT:", event.text)
        elif hasattr(event, 'message') and hasattr(event.message, 'content'):
            print("🎤 STT:", event.message.content)
        else:
            # Debug: print the event to see its structure
            print("🎤 STT Event (debug):", event)
            print("🎤 STT Event type:", type(event))
            print("🎤 STT Event dir:", [x for x in dir(event) if not x.startswith('_')])
    
    # Listen for user messages (transcribed speech)
    session.on("user_message", on_user_message)
    
    # Also try user_speech event (alternative)
    def on_user_speech(event):
        """Alternative handler for user speech events"""
        if hasattr(event, 'text') and event.text:
            print("🎤 STT (speech):", event.text)
        elif hasattr(event, 'transcript') and event.transcript:
            print("🎤 STT (speech):", event.transcript)
        else:
            print("🎤 Speech Event (debug):", event)
    
    session.on("user_speech", on_user_speech)

    ##############PRINT TTS TEXT (LLM reply) ##########################
    def on_assistant_response(event):
        if hasattr(event, 'type') and event.type == "output_text":
            print("🗣️ TTS Output Text:", event.text)
        elif hasattr(event, 'text') and event.text:
            print("🗣️ TTS Output Text:", event.text)
        elif hasattr(event, 'content') and event.content:
            print("🗣️ TTS Output Text:", event.content)

    session.on("assistant_response", on_assistant_response)

    await session.start(
        room=ctx.room,
        agent=Assistant(),
        room_options=room_io.RoomOptions(
            audio_input=room_io.AudioInputOptions(
                noise_cancellation=lambda params: noise_cancellation.BVCTelephony() 
                if params.participant.kind == rtc.ParticipantKind.PARTICIPANT_KIND_SIP 
                else noise_cancellation.BVC(),
            ),
        ),
    )

    await session.generate_reply(
        instructions=f"Greet the user and begin the assessment as per {AGENT_INSTRUCTIONS}."
    )


if __name__ == "__main__":
    agents.cli.run_app(server)

